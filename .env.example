# Postgres connection string. If you add a database via Vercel's Storage
# tab, this gets filled in for you automatically — you won't need to touch
# this file at all for deployment. Only needed here if running locally.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate one free at https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Set to your deployed URL in production, e.g. https://gainz.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Free API key from https://aistudio.google.com/apikey — no credit card
# required. Used server-side only, for reading food photos.
GEMINI_API_KEY="AIza..."
